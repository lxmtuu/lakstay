# ===== LakStay .env mẫu =====
# Copy file này thành .env rồi chỉnh giá trị.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000

# BẮT BUỘC đổi khi deploy production (server sẽ từ chối khởi động nếu để giá trị dev)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Đường dẫn file SQLite (mặc định: src/data/lakstay.db)
# DB_FILE=/var/lib/lakstay/lakstay.db

# Nghiệp vụ đặt phòng
BOOKING_HOLD_MINUTES=15
MAX_ROOMS_PER_BOOKING=5
QR_EXPIRE_MINUTES=15

# Giá
TAX_PCT=10
SERVICE_FEE_PCT=5
WEEKEND_SURCHARGE_PCT=15

# Rate limit
RL_GLOBAL_MAX=600
RL_AUTH_MAX=20
RL_BOOKING_MAX=10
RL_REGISTER_MAX=10

# Thông tin thụ hưởng VietQR — thay bằng tài khoản thật
BANK_BIN=970436
BANK_NAME=Vietcombank
BANK_ACCOUNT=1018734562
BANK_ACCOUNT_NAME=LAKSTAY HOTEL JSC
PAYMENT_WEBHOOK_SECRET=

# CORS: danh sách origin, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000

# Cấu hình reverse proxy (Nginx/Cloudflare): false | true | số hop (vd: 1)
TRUST_PROXY=false

# Tắt background job (khi chạy test song song)
# DISABLE_JOBS=true
# Cho phép nút "Giả lập đã thanh toán (Demo)" ở môi trường preview/demo (KHÔNG bật trên prod thật)
# DEMO_MODE=false
LOG_LEVEL=info
